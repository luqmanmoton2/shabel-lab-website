         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Negative learning bias is associated with risk aversion in a genetic animal model of depression</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Steven J. Shabel and Roberto Malinow</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The lateral habenula (LHb) is activated by aversive stimuli and the omission of reward, inhibited by rewarding stimuli and is hyperactive in helpless rats‚Äîan animal model of depression.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>lateral habenula</rdf:li>
               <rdf:li>reinforcement learning</rdf:li>
               <rdf:li>depression</rdf:li>
               <rdf:li>helplessness</rdf:li>
               <rdf:li>cLH</rdf:li>
               <rdf:li>risk aversion</rdf:li>
               <rdf:li>reward</rdf:li>
               <rdf:li>behavior</rdf:li>
            </rdf:Bag>
         </dc:subject>
