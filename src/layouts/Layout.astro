<style is:global>
    /* 1. CSS Variables: UTSW Brand Design System */
    :root {
        --primary-color: #004c97; /* Official UTSW Blue */
        --accent-gray: #636466;   /* Official UTSW Gray */
        --text-main: #1a1a1a;     /* Very dark gray for high-contrast reading */
