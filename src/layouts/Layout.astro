        color: var(--primary-color);
        text-decoration: none;
        letter-spacing: 1px;
    }

    .nav-links a {
        margin-left: 2rem;
        text-decoration: none;
        color: var(--text-main);
        font-weight: 500;
        transition: color 0.2s ease;
    }

