---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Shabel Lab">
    <section class="page-header">
        <h1>Contact Us</h1>
        <p>Interested in joining the lab or collaborating? We would love to hear from you.</p>
    </section>

    <section class="contact-container">
        
        <!-- Left Column: Contact Information -->
        <div class="contact-info">
            <h2>Get in Touch</h2>
            
            <div class="info-block">
                <h3>Principal Investigator</h3>
                <p><strong>Steven Shabel</strong></p>
                <!-- Standard UTSW email format placeholder -->
                <p>Email: <a href="mailto:steven.shabel@utsouthwestern.edu">steven.shabel@utsouthwestern.edu</a></p>
            </div>

            <div class="info-block">
                <h3>Lab Location</h3>
                <p>UT Southwestern Medical Center</p>
                <p>2201 Inwood Rd.</p>
                <p>Dallas, TX 75235</p>
            </div>

            <div class="info-block">
                <h3>Join the Lab</h3>
                <p>We welcome curious, motivated graduate students and postdoctoral fellows who thrive in a collaborative, fast-paced research environment and are excited to tackle ambitious questions about the brain and behavior.</p>
            </div>
        </div>

        <!-- Right Column: Maps -->
        <div class="maps-column">
            
            <!-- Static Campus Map Image -->
            <div class="map-container image-container">
                <img src="/images/NorthCamplook.png" alt="UT Southwestern North Campus Map" class="campus-map-img" />
            </div>

            <!-- Google Maps Embed for UT Southwestern -->
            <div class="map-container">
                <iframe 
                    src="https://maps.google.com/maps?q=2201%20Inwood%20Rd,%20Dallas,%20TX%2075235&t=&z=15&ie=UTF8&iwloc=&output=embed" 
                    width="100%" 
                    height="100%" 
                    style="border:0;" 
                    allowfullscreen="" 
                    loading="lazy" 
                    referrerpolicy="no-referrer-when-downgrade"
                    title="Google Map of 2201 Inwood Rd, Dallas, TX">
                </iframe>
            </div>

        </div>

    </section>
</Layout>

<style>
    /* 1. Page Header Styling */
    .page-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .page-header h1 {
        color: var(--primary-color);
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
    }

    .page-header p {
        color: var(--text-muted);
        max-width: 600px;
        margin: 0 auto;
        font-size: 1.1rem;
    }

    /* 2. Main Container (CSS Grid for the 2 columns) */
    .contact-container {
        display: grid;
        grid-template-columns: 1fr; /* Defaults to a single stacked column on mobile */
        gap: 3rem;
        max-width: 1000px;
        margin: 0 auto;
        background-color: #ffffff;
        padding: 3rem;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    }

    /* Switches to a two-column layout on screens wider than a tablet */
    @media (min-width: 768px) {
        .contact-container {
            grid-template-columns: 1fr 1fr;
        }
    }

    /* 3. Contact Information Styling */
    .contact-info h2 {
        color: var(--primary-color);
        margin-top: 0;
        margin-bottom: 2rem;
        font-size: 1.8rem;
    }

    .info-block {
        margin-bottom: 2rem;
    }

    .info-block h3 {
        font-size: 1.2rem;
        color: var(--text-main);
        margin-bottom: 0.5rem;
        border-bottom: 2px solid var(--bg-page);
        padding-bottom: 0.25rem;
    }

    .info-block p {
        margin: 0.25rem 0;
        color: var(--text-muted);
        line-height: 1.6;
    }

    .info-block strong {
        color: var(--text-main);
    }

    .info-block a {
        color: var(--primary-color);
        text-decoration: none;
        font-weight: 600;
    }

    .info-block a:hover {
        text-decoration: underline;
    }

    /* 4. Map Container Layout */
    .maps-column {
        display: flex;
        flex-direction: column;
        gap: 2rem; /* Creates the space between the image and the Google Map */
    }

    .map-container {
        min-height: 350px;
        border-radius: 8px;
        overflow: hidden; 
        border: 2px solid var(--bg-page);
        display: flex; /* Ensures inner elements stretch correctly */
    }

    /* Modifies the static image container to be a bit shorter than the Google Map */
    .image-container {
        min-height: 250px;
    }

    /* 5. Map Image Styling */
    .campus-map-img {
        width: 100%;
        height: 100%;
        object-fit: cover; 
        display: block;
    }
</style>