---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Team | Shabel Lab">
    <section class="page-header">
        <h1>Meet the Team</h1>
        <p>The Shabel Lab is driven by a passionate group of researchers, postdocs, and students dedicated to understanding the lateral habenula.</p>
    </section>

    <!-- Team Roster Grid -->
    <section class="team-grid">
        
        <!-- Member 1: Principal Investigator -->
        <div class="member-card">
            <!-- We will replace this div with an actual <img> tag later -->
            <div class="image-placeholder"></div> 
            <h2>Dr. Steven Shabel</h2>
            <p class="role">Principal Investigator</p>
            <p class="bio">Brief bio about Dr. Shabel's background, research focus, and academic history goes right here.</p>
            <a href="mailto:placeholder@utsouthwestern.edu" class="email-link">Email</a>
        </div>

        <!-- Member 2: Example Postdoc -->
        <div class="member-card">
            <div class="image-placeholder"></div>
            <h2>You-Hsin Lin, Ph.D.</h2>
            <p class="role">Postdoctoral Researcher</p>
            <p class="bio">Jane focuses on circuit mapping and electrophysiology to understand behavioral adaptations.</p>
            <a href="mailto:placeholder@utsouthwestern.edu" class="email-link">Email</a>
        </div>

        <!-- Member 3: Example Grad Student -->
        <div class="member-card">
            <div class="image-placeholder"></div>
            <h2>Ian Nelson</h2>
            <p class="role">Graduate Student</p>
            <p class="bio">John is investigating the molecular mechanisms underlying reward processing.</p>
            <a href="mailto:placeholder@utsouthwestern.edu" class="email-link">Email</a>
        </div>

    </section>
</Layout>

<style>
    /* Page Header Styling */
    .page-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .page-header h1 {
        color: var(--primary-color);
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
    }

    .page-header p {
        color: var(--text-muted);
        max-width: 600px;
        margin: 0 auto;
        font-size: 1.1rem;
    }

    /* CSS Grid for the Team Cards */
    .team-grid {
        display: grid;
        /* This line makes it responsive automatically! */
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); 
        gap: 2rem;
    }

    /* Individual Card Styling */
    .member-card {
        background-color: #ffffff;
        padding: 2rem;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        text-align: center;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    /* Subtle hover effect so the card lifts up slightly */
    .member-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
    }

    /* Temporary Image Placeholder */
    .image-placeholder {
        width: 150px;
        height: 150px;
        background-color: var(--accent-gray);
        border-radius: 50%; /* Makes it a perfect circle */
        margin: 0 auto 1.5rem auto;
        opacity: 0.2; /* Keeps it subtle until we add real photos */
    }

    .member-card h2 {
        margin: 0;
        font-size: 1.4rem;
        color: var(--primary-color);
    }

    .role {
        font-weight: 600;
        color: var(--accent-gray);
        margin-top: 0.2rem;
        margin-bottom: 1rem;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    .bio {
        font-size: 0.95rem;
        margin-bottom: 1.5rem;
    }

    .email-link {
        display: inline-block;
        padding: 0.5rem 1.5rem;
        background-color: var(--bg-page);
        color: var(--primary-color);
        text-decoration: none;
        border-radius: 4px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: background-color 0.2s ease;
    }

    .email-link:hover {
        background-color: var(--primary-color);
        color: #ffffff;
    }
</style>