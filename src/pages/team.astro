        font-size: 1.1rem;
        color: var(--primary-color); /* UTSW Blue makes the names pop without needing a box */
    }

    .alumni-entry .former-role {
        margin: 0;
        font-size: 0.9rem;
        color: var(--text-main);
    }

    .alumni-card h4 {
        margin: 0 0 0.25rem 0;
        font-size: 1.1rem;
        color: var(--text-main);
    }
    
    /* Alumni Grouping Styles */
    .alumni-group {
        margin-bottom: 3rem; /* Creates space between the different role sections */
    }

    .group-heading {
        color: var(--text-main);
        font-size: 1.25rem;
        margin-top: 0;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 0.5rem;
    }

    .former-role {
        margin: 0 0 0.5rem 0;
        font-size: 0.85rem;
        color: var(--accent-gray);
        font-weight: 600;
    }

    .current-position {
        margin: 0;
        font-size: 0.9rem;
        color: var(--text-main);
    }

    /* Modal (Pop-up) Styling */
    .member-modal {
        border: none;
        border-radius: 12px;
        padding: 0;
        width: 90%;
        max-width: 650px;
        background-color: #ffffff;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    .member-modal::backdrop {
        background-color: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(3px);
    }

    .modal-content {
        padding: 2.5rem;
        position: relative;
    }

    .close-btn {
        position: absolute;
        top: 1rem;
        right: 1.5rem;
        font-size: 2rem;
        background: none;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        transition: color 0.2s;
    }

    .close-btn:hover {
        color: var(--primary-color);
    }

    .modal-header {
        display: flex;
        align-items: center;
        gap: 2rem;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .modal-image {
        width: 120px;
        height: 120px;
        flex-shrink: 0;
    }

    .modal-title-group h2 {
        font-size: 1.8rem;
        margin: 0;
        color: var(--primary-color);
    }

    .modal-title-group .role {
        margin-bottom: 1rem;
    }

    .email-link {
        display: inline-block;
        padding: 0.4rem 1rem;
        background-color: var(--primary-color);
        color: #ffffff;
        text-decoration: none;
        border-radius: 4px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: background-color 0.2s ease;
    }

    .email-link:hover {
        background-color: #00366b;
    }

    .modal-body h3 {
        color: var(--text-main);
        margin-top: 0;
        margin-bottom: 0.5rem;
        font-size: 1.2rem;
    }

    .modal-body p {
        margin-bottom: 1.5rem;
        line-height: 1.6;
    }

    .modal-projects ul {
        padding-left: 1.5rem;
        margin: 0;
    }

    .modal-projects li {
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
        color: var(--text-muted);
    }
</style>

<script>
    const cards = document.querySelectorAll('.member-card');
    const closeBtns = document.querySelectorAll('.close-btn');
    const modals = document.querySelectorAll('.member-modal');

    cards.forEach(card => {
        card.addEventListener('click', () => {
            const targetId = card.getAttribute('data-modal-target');
            const targetModal = document.getElementById(targetId) as HTMLDialogElement;
            if (targetModal) targetModal.showModal();
        });
    });

    closeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const targetId = btn.getAttribute('data-modal-close');
            const targetModal = document.getElementById(targetId) as HTMLDialogElement;
            if (targetModal) targetModal.close();
        });
    });

    modals.forEach(modal => {
        // We added ": MouseEvent" right here!
        modal.addEventListener('click', (e: MouseEvent) => {
            const dialogDimensions = modal.getBoundingClientRect();
            if (
                e.clientX < dialogDimensions.left ||
                e.clientX > dialogDimensions.right ||
                e.clientY < dialogDimensions.top ||
                e.clientY > dialogDimensions.bottom
            ) {
                (modal as HTMLDialogElement).close();
            }
        });
    });
</script>