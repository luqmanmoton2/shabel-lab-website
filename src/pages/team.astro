// ... your existing currentMembers and alumniMembers arrays ...

// 3. Automatically Group Alumni by Role
const groupedAlumni = {
    "Postdoctoral Fellows": [],
    "Medical Interns": [],
    "Graduate Students": [],
    "Research Assistants": [],
    "Undergraduates & Interns": [] // This will act as the catch-all for UTD/SURF/Amgen
};

alumniMembers.forEach((alumni) => {
    // Convert to lowercase so we don't have to worry about capitalization
    const role = alumni.formerRole.toLowerCase();
    
    if (role.includes("postdoc")) {
        groupedAlumni["Postdoctoral Fellows"].push(alumni);
    } else if (role.includes("medical intern")) {
        groupedAlumni["Medical Interns"].push(alumni);
    } else if (role.includes("graduate student")) {
        groupedAlumni["Graduate Students"].push(alumni);
    } else if (role.includes("research assistant")) {
        groupedAlumni["Research Assistants"].push(alumni);
    } else {
        // Anyone else automatically goes into this final group
        groupedAlumni["Undergraduates & Interns"].push(alumni);
    }
});
---

<Layout title="Team | Shabel Lab">
    <section class="page-header">
        <h1>Meet the Team</h1>
    </section>

    <section class="team-section">
        <h2 class="section-title">Current Members</h2>
        <div class="team-grid">
            {currentMembers.map((member) => (
                <div class="member-card" data-modal-target={member.id}>
                    {member.image ? (
                        <img src={member.image} alt={`Headshot of ${member.name}`} class="profile-img card-img" />
                    ) : (
                        <div class="image-placeholder card-img"></div>
                    )} 
                    <h3>{member.name}</h3>
                    <p class="role">{member.role}</p>
                    <div class="click-hint">Click to read more</div>
                </div>
            ))}
        </div>
    </section>

    <section class="alumni-section">
        <h2 class="section-title">Lab Alumni</h2>
        
        <!-- Loop through our newly sorted groups -->
        {Object.entries(groupedAlumni).map(([groupName, members]) => {
            
            // If a group is empty, skip it completely
            if (members.length === 0) return null;
            
            return (
                <div class="alumni-group">
                    <h3 class="group-heading">{groupName}</h3>
                    <div class="alumni-directory">
                        
                        <!-- Map through the members of this specific group -->
                        {members.map((alumni) => (
                            <div class="alumni-entry">
                                <h4>{alumni.name}</h4>
                                <p class="former-role">{alumni.formerRole}</p>
                                <!-- <p class="current-position"><em>Currently:</em> {alumni.currentPosition}</p> -->
                            </div>
                        ))}

                    </div>
                </div>
            )
        })}
    </section>

    {currentMembers.map((member) => (
        <dialog id={member.id} class="member-modal">
            <div class="modal-content">
                <button class="close-btn" data-modal-close={member.id}>&times;</button>
                
                <div class="modal-header">
                    {member.image ? (
                        <img src={member.image} alt={`Headshot of ${member.name}`} class="profile-img modal-image" />
                    ) : (
                        <div class="image-placeholder modal-image"></div>
                    )}
                    <div class="modal-title-group">
                        <h2>{member.name}</h2>
                        <p class="role">{member.role}</p>
                        <a href={`mailto:${member.email}`} class="email-link">Email</a>
                    </div>
                </div>

                <div class="modal-body">
                    <h3>About</h3>
                    <p>{member.bio}</p>
                    
                    {member.projects.length > 0 && (
                        <div class="modal-projects">
                            <h3>Current Projects</h3>
                            <ul>
                                {member.projects.map((pub) => (
                                    <li>{pub}</li>
                                ))}
                            </ul>
                        </div>
                    )}
                </div>
            </div>
        </dialog>
    ))}
</Layout>

<style>
    /* Page Header */
    .page-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .page-header h1 {
        color: var(--primary-color);
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
    }

    .page-header p {
