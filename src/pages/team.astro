        max-width: 600px;
        margin: 0 auto;
        font-size: 1.1rem;
    }

    .section-title {
        color: var(--primary-color);
        font-size: 1.8rem;
        border-bottom: 2px solid var(--accent-gray);
        padding-bottom: 0.5rem;
        margin-bottom: 2rem;
    }

    /* Current Members Grid & Cards */
    /* Current Members Grid & Cards */
    .team-section {
        margin-bottom: 5rem;
    }

    .team-grid {
        /* CHANGED: Switched from grid to flex to easily center orphaned cards */
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 2rem;
    }

    .member-card {
        /* NEW: This tells the card to grow to fill space, but never get wider than 350px */
        flex: 1 1 280px;
        max-width: 350px; 
        
        /* Your exact existing styles below */
        background-color: #ffffff;
        padding: 2rem;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        text-align: center;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        border: 2px solid transparent;
    }

    .member-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
        border-color: var(--primary-color);
    }

    .click-hint {
        font-size: 0.8rem;
        color: var(--primary-color);
        margin-top: 1rem;
        font-weight: 600;
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    .member-card:hover .click-hint {
        opacity: 1;
    }

    /* The fallback gray circle if someone doesn't have a photo yet */
    .image-placeholder {
        background-color: var(--accent-gray);
        opacity: 0.2;
    }

    /* Makes the actual photos perfectly round without squishing them */
    .profile-img {
        object-fit: cover;
        display: block;
    }

    /* Both placeholders and photos share these dimensions on the main grid */
    .card-img, .profile-img.card-img {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        margin: 0 auto 1.5rem auto;
    }

    /* Modal image dimensions */
    .modal-image {
        width: 120px;
        height: 120px;
        flex-shrink: 0;
        border-radius: 50%;
    }

    .member-card h3 {
        margin: 0;
        font-size: 1.4rem;
        color: var(--primary-color);
    }

    .role {
        font-weight: 600;
        color: var(--accent-gray);
        margin-top: 0.2rem;
        margin-bottom: 0;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    /* Alumni Grid & Cards */
    /* Clean, multi-column text directory */
    .alumni-directory {
        display: grid;
        /* Drops the width requirement so we can fit 3 or 4 columns on large screens */
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); 
        gap: 1.5rem 2rem; /* 1.5rem vertical spacing, 2rem horizontal spacing */
    }

    .alumni-entry {
