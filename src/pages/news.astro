---
import Layout from '../layouts/Layout.astro';
import { newsUpdates } from '../data/newsData.js'; 
---

<Layout title="News | Shabel Lab">
    <section class="page-header">
        <h1>Lab News</h1>
        <p>The latest updates, announcements, and events from our team.</p>
    </section>

    <section class="news-list">
        {newsUpdates.map((item) => (
            <article class="news-item">
                <span class="date">{item.date}</span>
                <h2>{item.title}</h2>
                <p>{item.snippet}</p>
                <!-- Only render the link if you actually put a URL in the data file -->
                {item.link && <a href={item.link} class="read-more">Read More &rarr;</a>}
            </article>
        ))}
    </section>
</Layout>

<style>
    /* 1. Page Header Styling */
    .page-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .page-header h1 {
        color: var(--primary-color);
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
    }

    .page-header p {
        color: var(--text-muted);
        font-size: 1.1rem;
    }

    /* 2. Container Styling - This is where the gaps happen! */
    .news-list {
        max-width: 800px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 2rem; /* Creates the empty space between each card */
    }

    /* 3. Individual Card Styling */
    .news-item {
        background-color: #ffffff;
        padding: 2.5rem;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        border-left: 4px solid var(--primary-color);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .news-item:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
    }

    .date {
        font-size: 0.85rem;
        font-weight: bold;
        color: var(--accent-gray);
        text-transform: uppercase;
        letter-spacing: 1px;
        display: block;
        margin-bottom: 0.75rem;
    }

    .news-item h2 {
        margin: 0 0 1rem 0;
        color: var(--primary-color);
        font-size: 1.5rem;
    }

    .news-item p {
        color: var(--text-main);
        margin-bottom: 1.5rem;
        line-height: 1.6;
        font-size: 1.05rem;
    }
    
    .read-more {
        color: var(--primary-color);
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
    }

    .read-more:hover {
        text-decoration: underline;
    }
    
</style>